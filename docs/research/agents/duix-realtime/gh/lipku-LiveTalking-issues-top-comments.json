86ipm8p","number":317,"title":"建议加个UltralightDigitalHuman版本","user":{"login":"cacard","id":863897,"node_id":"MDQ6VXNlcjg2Mzg5Nw==","avatar_url":"https://avatars.githubusercontent.com/u/863897?v=4","gravatar_id":"","url":"https://api.github.com/users/cacard","html_url":"https://github.com/cacard","followers_url":"https://api.github.com/users/cacard/followers","following_url":"https://api.github.com/users/cacard/following{/other_user}","gists_url":"https://api.github.com/users/cacard/gists{/gist_id}","starred_url":"https://api.github.com/users/cacard/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cacard/subscriptions","organizations_url":"https://api.github.com/users/cacard/orgs","repos_url":"https://api.github.com/users/cacard/repos","events_url":"https://api.github.com/users/cacard/events{/privacy}","received_events_url":"https://api.github.com/users/cacard/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":18,"created_at":"2024-12-10T02:52:39Z","updated_at":"2025-05-21T03:05:31Z","closed_at":"2025-01-08T01:09:43Z","assignee":null,"author_association":"NONE","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"UltralightDigitalHuman的口型效果还是很不错的，比你现在用的几个方案的口型效果都要好，建议作者加上。","reactions":{"url":"https://api.github.com/repos/lipku/LiveTalking/issues/317/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/lipku/LiveTalking/issues/317/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/lipku/LiveTalking/issues/516","repository_url":"https://api.github.com/repos/lipku/LiveTalking","labels_url":"https://api.github.com/repos/lipku/LiveTalking/issues/516/labels{/name}","comments_url":"https://api.github.com/repos/lipku/LiveTalking/issues/516/comments","events_url":"https://api.github.com/repos/lipku/LiveTalking/issues/516/events","html_url":"https://github.com/lipku/LiveTalking/issues/516","id":3313102069,"node_id":"I_kwDOK7UGY87Feez1","number":516,"title":"64核CPU；RTX4090；三并发卡顿问题请教","user":{"login":"WangSiyao666","id":167976085,"node_id":"U_kgDOCgMclQ","avatar_url":"https://avatars.githubusercontent.com/u/167976085?v=4","gravatar_id":"","url":"https://api.github.com/users/WangSiyao666","html_url":"https://github.com/WangSiyao666","followers_url":"https://api.github.com/users/WangSiyao666/followers","following_url":"https://api.github.com/users/WangSiyao666/following{/other_user}","gists_url":"https://api.github.com/users/WangSiyao666/gists{/gist_id}","starred_url":"https://api.github.com/users/WangSiyao666/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/WangSiyao666/subscriptions","organizations_url":"https://api.github.com/users/WangSiyao666/orgs","repos_url":"https://api.github.com/users/WangSiyao666/repos","events_url":"https://api.github.com/users/WangSiyao666/events{/privacy}","received_events_url":"https://api.github.com/users/WangSiyao666/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":18,"created_at":"2025-08-12T08:20:27Z","updated_at":"2025-09-30T06:41:59Z","closed_at":"2025-08-19T03:28:47Z","assignee":null,"author_association":"NONE","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"服务器配置为：\nCPU：64核；\n显卡：NVIDIA GeForce RTX 4090；\n\n![Image](https://github.com/user-attachments/assets/73783a74-d3f2-4073-a8e9-6f3c1ccb1d88)\n\n使用以下命令启动（musetalkV1.5 + fish-speech）\n--transport 